    vet_bitmap: .word bmp_pikachu, bmp_eevee, bmp_charmander, bmp_squirtle, bmp_bulbasaur
    vet_golpe1: .word g_choque, g_investida, g_arranhao, g_investida, g_investida
    vet_golpe2: .word g_cauda, g_mordida, g_brasas, g_jato, g_chicote
    vet_defesa: .word d_protecao, d_areia, d_fumaca, d_recolher, d_protecao
    vet_item:   .word i_oran, i_pocao, i_oran, i_pocao, i_oran
    vet_anim1:  .word 1, 3, 5, 3, 3
    vet_anim2:  .word 2, 4, 6, 7, 8

.text
main:
    li $s0, 100
    li $s1, 100
    li $s6, 1
    li $s7, 1
    li $t0, 15
    sw $t0, j1_pp
    sw $t0, j2_pp
    jal zera_offsets

    jal desenha_tela_modo
    li $a0, 1
    li $a1, 2
    jal le_opcao_mmio
    sw $v0, modo_jogo

    li $a0, 1
    jal escolhe_pokemon_tela
    sw $v0, j1_especie

    lw $t0, modo_jogo
    beq $t0, 2, ia_escolhe_pokemon

    li $a0, 2
    jal escolhe_pokemon_tela
    sw $v0, j2_especie
    j loop_batalha

ia_escolhe_pokemon:
    li $v0, 42
    li $a0, 0
    lw $a1, num_pokemon
    syscall
    sw $a0, j2_especie

loop_batalha:
    move $a0, $s0
    move $a1, $s1
    jal desenha_arena

    beq $s0, 0, check_empate_tela
    beq $s1, 0, vitoria_j2
    j coleta_de_inputs

check_empate_tela:
    beq $s1, 0, tela_empate
    j vitoria_j1

coleta_de_inputs:
    li $t7, 0
input_j1:
    li $a0, 1
    lw $a1, j1_especie
    lw $a2, j1_pp
    move $a3, $t7
    jal desenha_menu_tela

    li $a0, 1
    li $a1, 4
    jal le_opcao_mmio
    move $t8, $v0
    sw $t8, escolha_j1

    beq $t8, 1, prepara_j2
    beq $t8, 4, check_item_j1
    j check_pp_j1

check_pp_j1:
    lw $t5, j1_pp
    blez $t5, erro_pp_j1
    subi $t5, $t5, 1
    sw $t5, j1_pp
    j prepara_j2

check_item_j1:
    beq $s6, 0, erro_item_j1
    beq $s1, 100, erro_hp_cheio_j1
    j prepara_j2

erro_pp_j1:
    li $t7, 1
    j input_j1

erro_item_j1:
    li $t7, 2
    j input_j1

erro_hp_cheio_j1:
    li $t7, 3
    j input_j1

prepara_j2:
    lw $t0, modo_jogo
    beq $t0, 2, vez_da_ia

    li $t7, 0
input_j2:
    li $a0, 2
    lw $a1, j2_especie
    lw $a2, j2_pp
    move $a3, $t7
    jal desenha_menu_tela

    li $a0, 1
    li $a1, 4
    jal le_opcao_mmio
    move $t9, $v0
    sw $t9, escolha_j2

    beq $t9, 1, fase_de_resolucao
    beq $t9, 4, check_item_j2
    j check_pp_j2

check_pp_j2:
    lw $t6, j2_pp
    blez $t6, erro_pp_j2
    subi $t6, $t6, 1
    sw $t6, j2_pp
    j fase_de_resolucao

check_item_j2:
    beq $s7, 0, erro_item_j2
    beq $s0, 100, erro_hp_cheio_j2
    j fase_de_resolucao

erro_pp_j2:
    li $t7, 1
    j input_j2

erro_item_j2:
    li $t7, 2
    j input_j2

erro_hp_cheio_j2:
    li $t7, 3
    j input_j2

vez_da_ia:
    li $v0, 42
    li $a0, 0
    li $a1, 4
    syscall
    addi $t9, $a0, 1

    beq $t9, 1, ia_confirma
    beq $t9, 4, check_item_ia
    j check_pp_ia

check_pp_ia:
    lw $t6, j2_pp
    blez $t6, vez_da_ia
    subi $t6, $t6, 1
    sw $t6, j2_pp
    j ia_confirma

check_item_ia:
    beq $s7, 0, vez_da_ia
    beq $s0, 100, vez_da_ia
    j ia_confirma

ia_confirma:
    sw $t9, escolha_j2

fase_de_resolucao:
    li $s4, 0
    li $s5, 0

    lw $t8, escolha_j1
    beq $t8, 3, j1_set_defesa
    beq $t8, 4, j1_set_item
    j check_j2_def_item

j1_set_defesa:
    li $s4, 1
    li $a0, 1
    lw $a1, j1_especie
    li $a2, 3
    li $a3, 3
    jal mostra_log_tela
    li $a0, 1
    li $a1, 9
    move $a2, $s0
    move $a3, $s1
    jal anima_acao
    li $a0, 550
    jal espera
    j check_j2_def_item

j1_set_item:
    li $s6, 0
    addi $s1, $s1, 30
    ble $s1, 100, ok_item_j1
    li $s1, 100
ok_item_j1:
    li $a0, 1
    lw $a1, j1_especie
    li $a2, 4
    li $a3, 4
    jal mostra_log_tela
    li $a0, 1
    li $a1, 10
    move $a2, $s0
    move $a3, $s1
    jal anima_acao
    li $a0, 550
    jal espera

check_j2_def_item:
    lw $t9, escolha_j2
    beq $t9, 3, j2_set_defesa
    beq $t9, 4, j2_set_item
    j processa_ataques

j2_set_defesa:
    li $s5, 1
    li $a0, 2
    lw $a1, j2_especie
    li $a2, 3
    li $a3, 3
    jal mostra_log_tela
    li $a0, 2
    li $a1, 9
    move $a2, $s0
    move $a3, $s1
    jal anima_acao
    li $a0, 550
    jal espera
    j processa_ataques

j2_set_item:
    li $s7, 0
    addi $s0, $s0, 30
    ble $s0, 100, ok_item_j2
    li $s0, 100
ok_item_j2:
    li $a0, 2
    lw $a1, j2_especie
    li $a2, 4
    li $a3, 4
    jal mostra_log_tela
    li $a0, 2
    li $a1, 10
    move $a2, $s0
    move $a3, $s1
    jal anima_acao
    li $a0, 550
    jal espera

processa_ataques:
    lw $t8, escolha_j1
    beq $t8, 1, j1_usa_atk1
    beq $t8, 2, j1_usa_atk2
    j processa_ataques_j2

j1_usa_atk1:
    li $a0, 1
    lw $a1, j1_especie
    li $a2, 1
    li $a3, 0
    jal mostra_log_tela
    lw $t0, j1_especie
    sll $t0, $t0, 2
    la $t1, vet_anim1
    add $t1, $t1, $t0
    lw $a1, 0($t1)
    li $a0, 1
    move $a2, $s0
    move $a3, $s1
    jal anima_acao
    beq $s5, 1, j1_bloqueado_atk1
    subi $s0, $s0, 20
    bge $s0, 0, j1_atk1_hit
    li $s0, 0
j1_atk1_hit:
    li $a0, 1
    lw $a1, j1_especie
    li $a2, 1
    li $a3, 1
    jal mostra_log_tela
    li $a0, 2
    move $a1, $s0
    move $a2, $s1
    jal anima_dano
    li $a0, 650
    jal espera
    j processa_ataques_j2

j1_usa_atk2:
    li $a0, 1
    lw $a1, j1_especie
    li $a2, 2
    li $a3, 0
    jal mostra_log_tela
    lw $t0, j1_especie
    sll $t0, $t0, 2
    la $t1, vet_anim2
    add $t1, $t1, $t0
    lw $a1, 0($t1)
    li $a0, 1
    move $a2, $s0
    move $a3, $s1
    jal anima_acao
    beq $s5, 1, j1_bloqueado_atk2
    subi $s0, $s0, 35
    bge $s0, 0, j1_atk2_hit
    li $s0, 0
j1_atk2_hit:
    li $a0, 1
    lw $a1, j1_especie
    li $a2, 2
    li $a3, 2
    jal mostra_log_tela
    li $a0, 2
    move $a1, $s0
    move $a2, $s1
    jal anima_dano
    li $a0, 650
    jal espera
    j processa_ataques_j2

j1_bloqueado_atk1:
    li $a0, 1
    lw $a1, j1_especie
    li $a2, 1
    li $a3, 5
    jal mostra_log_tela
    li $a0, 2
    li $a1, 9
    move $a2, $s0
    move $a3, $s1
    jal anima_acao
    li $a0, 650
    jal espera
    j processa_ataques_j2

j1_bloqueado_atk2:
    li $a0, 1
    lw $a1, j1_especie
    li $a2, 2
    li $a3, 5
    jal mostra_log_tela
    li $a0, 2
    li $a1, 9
    move $a2, $s0
    move $a3, $s1
    jal anima_acao
    li $a0, 650
    jal espera

processa_ataques_j2:
    lw $t9, escolha_j2
    beq $t9, 1, j2_usa_atk1
    beq $t9, 2, j2_usa_atk2
    j finaliza_turno

j2_usa_atk1:
    li $a0, 2
    lw $a1, j2_especie
    li $a2, 1
    li $a3, 0
    jal mostra_log_tela
    lw $t0, j2_especie
    sll $t0, $t0, 2
    la $t1, vet_anim1
    add $t1, $t1, $t0
    lw $a1, 0($t1)
    li $a0, 2
    move $a2, $s0
    move $a3, $s1
    jal anima_acao
    beq $s4, 1, j2_bloqueado_atk1
    subi $s1, $s1, 20
    bge $s1, 0, j2_atk1_hit
    li $s1, 0
j2_atk1_hit:
    li $a0, 2
    lw $a1, j2_especie
    li $a2, 1
    li $a3, 1
    jal mostra_log_tela
    li $a0, 1
    move $a1, $s0
    move $a2, $s1
    jal anima_dano
    li $a0, 650
    jal espera
    j finaliza_turno

j2_usa_atk2:
    li $a0, 2
    lw $a1, j2_especie
    li $a2, 2
    li $a3, 0
    jal mostra_log_tela
    lw $t0, j2_especie
    sll $t0, $t0, 2
    la $t1, vet_anim2
    add $t1, $t1, $t0
    lw $a1, 0($t1)
    li $a0, 2
    move $a2, $s0
    move $a3, $s1
    jal anima_acao
    beq $s4, 1, j2_bloqueado_atk2
    subi $s1, $s1, 35
    bge $s1, 0, j2_atk2_hit
    li $s1, 0
j2_atk2_hit:
    li $a0, 2
    lw $a1, j2_especie
    li $a2, 2
    li $a3, 2
    jal mostra_log_tela
    li $a0, 1
    move $a1, $s0
    move $a2, $s1
    jal anima_dano
    li $a0, 650
    jal espera
    j finaliza_turno

j2_bloqueado_atk1:
    li $a0, 2
    lw $a1, j2_especie
    li $a2, 1
    li $a3, 5
    jal mostra_log_tela
    li $a0, 1
    li $a1, 9
    move $a2, $s0
    move $a3, $s1
    jal anima_acao
    li $a0, 650
    jal espera
    j finaliza_turno

j2_bloqueado_atk2:
    li $a0, 2
    lw $a1, j2_especie
    li $a2, 2
    li $a3, 5
    jal mostra_log_tela
    li $a0, 1
    li $a1, 9
    move $a2, $s0
    move $a3, $s1
    jal anima_acao
    li $a0, 650
    jal espera

finaliza_turno:
    bge $s0, 0, checa_hp_j1
    li $s0, 0
checa_hp_j1:
    bge $s1, 0, volta_loop
    li $s1, 0
volta_loop:
    j loop_batalha

vitoria_j1:
    li $a0, 1
    jal desenha_fim_tela
    jal espera_qualquer_tecla
    j main

vitoria_j2:
    li $a0, 2
    jal desenha_fim_tela
    jal espera_qualquer_tecla
    j main

tela_empate:
    li $a0, 0
    jal desenha_fim_tela
    jal espera_qualquer_tecla
    j main

espera:
    li $v0, 32
    syscall
    jr $ra

le_opcao_mmio:
    addi $sp, $sp, -12
    sw $ra, 8($sp)
    sw $s0, 4($sp)
    sw $s1, 0($sp)
    move $s0, $a0
    move $s1, $a1
lom_loop:
    lui $t0, 0xFFFF
    lw $t1, 0($t0)
    andi $t1, $t1, 1
    beq $t1, $zero, lom_sleep
    lw $t2, 4($t0)
    subi $t2, $t2, 48
    blt $t2, $s0, lom_loop
    bgt $t2, $s1, lom_loop
    move $v0, $t2
    lw $s1, 0($sp)
    lw $s0, 4($sp)
    lw $ra, 8($sp)
    addi $sp, $sp, 12
    jr $ra
lom_sleep:
    li $a0, 20
    jal espera
    j lom_loop

espera_qualquer_tecla:
    addi $sp, $sp, -4
    sw $ra, 0($sp)
eqt_loop:
    lui $t0, 0xFFFF
    lw $t1, 0($t0)
    andi $t1, $t1, 1
    bne $t1, $zero, eqt_fim
    li $a0, 20
    jal espera
    j eqt_loop
eqt_fim:
    lw $t2, 4($t0)
    lw $ra, 0($sp)
    addi $sp, $sp, 4
    jr $ra

limpa_tela_cor:
    la $t0, tela
    li $t1, 0
ltc_loop:
    sw $a0, 0($t0)
    addi $t0, $t0, 4
    addi $t1, $t1, 1
    blt $t1, 16384, ltc_loop
    jr $ra

desenha_caixa_ui:
    addi $sp, $sp, -4
    sw $ra, 0($sp)
    li $t0, 0x00283040
    sw $t0, cor_atual
    li $a0, 0
    li $a1, 72
    li $a2, 128
    li $a3, 56
    jal desenha_retangulo
    li $t0, 0x00F8F8F0
    sw $t0, cor_atual
    li $a0, 2
    li $a1, 74
    li $a2, 124
    li $a3, 52
    jal desenha_retangulo
    lw $ra, 0($sp)
    addi $sp, $sp, 4
    jr $ra

desenha_tela_modo:
    addi $sp, $sp, -4
    sw $ra, 0($sp)

    li $a0, 0x001E2B45
    jal limpa_tela_cor

    li $t0, 0x002E4468
    sw $t0, cor_atual
    li $a0, 16
    li $a1, 8
    li $a2, 96
    li $a3, 18
    jal desenha_retangulo

    li $t0, 0x00FFD84A
    sw $t0, cor_atual
    li $a0, 32
    li $a1, 12
    la $a2, txt_titulo
    jal desenha_texto_2x

    li $a0, 20
    li $a1, 34
    li $a2, 0
    jal desenha_pokemon_2x
    li $a0, 76
    li $a1, 34
    li $a2, 2
    jal desenha_pokemon_2x

    jal desenha_caixa_ui

    li $t0, 0x00202020
    sw $t0, cor_atual
    li $a0, 8
    li $a1, 79
    la $a2, txt_modo
    jal desenha_texto

    li $a0, 8
    li $a1, 90
    la $a2, txt_modo1
    jal desenha_texto

    li $a0, 8
    li $a1, 100
    la $a2, txt_modo2
    jal desenha_texto

    li $t0, 0x002060B0
    sw $t0, cor_atual
    li $a0, 8
    li $a1, 114
    la $a2, txt_dig_12
    jal desenha_texto

    lw $ra, 0($sp)
    addi $sp, $sp, 4
    jr $ra

escolhe_pokemon_tela:
    addi $sp, $sp, -20
    sw $ra, 16($sp)
    sw $s0, 12($sp)
    sw $s1, 8($sp)
    sw $s2, 4($sp)
    sw $s3, 0($sp)
    move $s0, $a0

    li $a0, 0x001E2B45
    jal limpa_tela_cor

    li $t0, 0x00FFD84A
    sw $t0, cor_atual
    li $a0, 10
    li $a1, 7
    la $a2, txt_esc_j1
    beq $s0, 1, ept_tit
    la $a2, txt_esc_j2
ept_tit:
    jal desenha_texto

    li $s1, 0
    lw $s2, num_pokemon
ept_loop:
    beq $s1, $s2, ept_fim_lista
    mul $s3, $s1, 19
    addi $s3, $s3, 18

    li $t0, 0x002A3C5E
    sw $t0, cor_atual
    li $a0, 6
    move $a1, $s3
    li $a2, 116
    li $a3, 17
    jal desenha_retangulo

    li $a0, 10
    move $a1, $s3
    move $a2, $s1
    jal desenha_pokemon_1x

    li $t0, 0x00FFFFFF
    sw $t0, cor_atual
    li $a0, 32
    addi $a1, $s3, 6
    addi $a2, $s1, 1
    jal desenha_num

    move $a0, $v0
    addi $a1, $s3, 6
    la $a2, txt_traco
    jal desenha_texto

    sll $t0, $s1, 2
    la $t1, vet_nome
    add $t1, $t1, $t0
    move $a0, $v0
    addi $a1, $s3, 6
    lw $a2, 0($t1)
    jal desenha_texto

    addi $s1, $s1, 1
    j ept_loop

ept_fim_lista:
    li $t0, 0x0080E0FF
    sw $t0, cor_atual
    li $a0, 10
    li $a1, 117
    la $a2, txt_dig_15
    jal desenha_texto

    li $a0, 1
    lw $a1, num_pokemon
    jal le_opcao_mmio
    subi $v0, $v0, 1

    lw $s3, 0($sp)
    lw $s2, 4($sp)
    lw $s1, 8($sp)
    lw $s0, 12($sp)
    lw $ra, 16($sp)
    addi $sp, $sp, 20
    jr $ra

desenha_menu_tela:
    addi $sp, $sp, -24
    sw $ra, 20($sp)
    sw $s0, 16($sp)
    sw $s1, 12($sp)
    sw $s2, 8($sp)
    sw $s3, 4($sp)
    sw $s4, 0($sp)

    move $s0, $a0
    sll $s1, $a1, 2
    move $s2, $a2
    move $s3, $a3

    jal desenha_caixa_ui

    li $t0, 0x001848A0
    sw $t0, cor_atual
    li $a0, 6
    li $a1, 77
    la $a2, txt_j1
    beq $s0, 1, dmt_j_ok
    la $a2, txt_j2
dmt_j_ok:
    jal desenha_texto

    la $t1, vet_nome
    add $t1, $t1, $s1
    move $a0, $v0
    li $a1, 77
    lw $a2, 0($t1)
    jal desenha_texto

    move $a0, $v0
    li $a1, 77
    la $a2, txt_pp
    jal desenha_texto

    move $a0, $v0
    li $a1, 77
    move $a2, $s2
    jal desenha_num

    li $t0, 0x00202020
    sw $t0, cor_atual
    li $a0, 6
    li $a1, 86
    la $a2, txt_op1
    jal desenha_texto
    la $t1, vet_golpe1
    add $t1, $t1, $s1
    move $a0, $v0
    li $a1, 86
    lw $a2, 0($t1)
    jal desenha_texto
    move $a0, $v0
    li $a1, 86
    la $a2, txt_tag_20
    jal desenha_texto

    li $a0, 6
    li $a1, 94
    la $a2, txt_op2
    jal desenha_texto
    la $t1, vet_golpe2
    add $t1, $t1, $s1
    move $a0, $v0
    li $a1, 94
    lw $a2, 0($t1)
    jal desenha_texto
    move $a0, $v0
    li $a1, 94
    la $a2, txt_tag_35
    jal desenha_texto

    li $a0, 6
    li $a1, 102
    la $a2, txt_op3
    jal desenha_texto
    la $t1, vet_defesa
    add $t1, $t1, $s1
    move $a0, $v0
    li $a1, 102
    lw $a2, 0($t1)
    jal desenha_texto
    move $a0, $v0
    li $a1, 102
    la $a2, txt_tag_def
    jal desenha_texto

    li $a0, 6
    li $a1, 110
    la $a2, txt_op4
    jal desenha_texto
    la $t1, vet_item
    add $t1, $t1, $s1
    move $a0, $v0
    li $a1, 110
    lw $a2, 0($t1)
    jal desenha_texto
    move $a0, $v0
    li $a1, 110
    la $a2, txt_tag_cura
    jal desenha_texto

    beq $s3, 0, dmt_prompt
    li $t0, 0x00D82020
    sw $t0, cor_atual
    li $a0, 6
    li $a1, 118
    la $a2, txt_err_pp
    beq $s3, 1, dmt_rodape
    la $a2, txt_err_item
    beq $s3, 2, dmt_rodape
    la $a2, txt_err_hp
    j dmt_rodape

dmt_prompt:
    li $t0, 0x00307030
    sw $t0, cor_atual
    li $a0, 6
    li $a1, 118
    la $a2, txt_escolha_14

dmt_rodape:
    jal desenha_texto

    lw $s4, 0($sp)
    lw $s3, 4($sp)
    lw $s2, 8($sp)
    lw $s1, 12($sp)
    lw $s0, 16($sp)
    lw $ra, 20($sp)
    addi $sp, $sp, 24
    jr $ra

mostra_log_tela:
    addi $sp, $sp, -20
    sw $ra, 16($sp)
    sw $s0, 12($sp)
    sw $s1, 8($sp)
    sw $s2, 4($sp)
    sw $s3, 0($sp)

    move $s0, $a0
    sll $s1, $a1, 2
    move $s2, $a2
    move $s3, $a3

    jal desenha_caixa_ui

    li $t0, 0x001848A0
    sw $t0, cor_atual
    li $a0, 6
    li $a1, 80
    beq $s0, 1, mlt_j1
    lw $t1, modo_jogo
    beq $t1, 2, mlt_ia
    la $a2, txt_j2
    j mlt_tag
mlt_ia:
    la $a2, txt_ia
    j mlt_tag
mlt_j1:
    la $a2, txt_j1
mlt_tag:
    jal desenha_texto

    la $t1, vet_nome
    add $t1, $t1, $s1
    move $a0, $v0
    li $a1, 80
    lw $a2, 0($t1)
    jal desenha_texto

    move $a0, $v0
    li $a1, 80
    la $a2, txt_espaco
    jal desenha_texto

    move $a0, $v0
    li $a1, 80
    la $a2, txt_usou
    jal desenha_texto

    li $t0, 0x00202020
    sw $t0, cor_atual
    li $a0, 6
    li $a1, 93
    beq $s2, 1, mlt_g1
    beq $s2, 2, mlt_g2
    beq $s2, 3, mlt_def
    la $t1, vet_item
    j mlt_acao
mlt_g1:
    la $t1, vet_golpe1
    j mlt_acao
mlt_g2:
    la $t1, vet_golpe2
    j mlt_acao
mlt_def:
    la $t1, vet_defesa
mlt_acao:
    add $t1, $t1, $s1
    lw $a2, 0($t1)
    jal desenha_texto

    beq $s3, 0, mlt_fim
    li $a0, 6
    li $a1, 108
    beq $s3, 1, mlt_r1
    beq $s3, 2, mlt_r2
    beq $s3, 3, mlt_r3
    beq $s3, 4, mlt_r4
    li $t0, 0x002060B0
    sw $t0, cor_atual
    la $a2, txt_bloqueado
    j mlt_res
mlt_r1:
    li $t0, 0x00D02828
    sw $t0, cor_atual
    la $a2, txt_dano20
    j mlt_res
mlt_r2:
    li $t0, 0x00D02828
    sw $t0, cor_atual
    la $a2, txt_dano35
    j mlt_res
mlt_r3:
    li $t0, 0x002070B8
    sw $t0, cor_atual
    la $a2, txt_defendeu
    j mlt_res
mlt_r4:
    li $t0, 0x00209030
    sw $t0, cor_atual
    la $a2, txt_curou
mlt_res:
    jal desenha_texto

mlt_fim:
    lw $s3, 0($sp)
    lw $s2, 4($sp)
    lw $s1, 8($sp)
    lw $s0, 12($sp)
    lw $ra, 16($sp)
    addi $sp, $sp, 20
    jr $ra

desenha_fim_tela:
    addi $sp, $sp, -8
    sw $ra, 4($sp)
    sw $s0, 0($sp)
    move $s0, $a0

    jal desenha_caixa_ui

    li $t0, 0x00C87800
    sw $t0, cor_atual
    li $a0, 8
    li $a1, 84
    beq $s0, 0, dft_emp
    beq $s0, 1, dft_j1
    lw $t1, modo_jogo
    beq $t1, 2, dft_ia
    la $a2, txt_vit_j2
    j dft_msg
dft_ia:
    la $a2, txt_vit_ia
