.data
    tela: .space 65536

    j1_pp: .word 15
    j2_pp: .word 15

    modo_jogo: .word 1

    j1_especie: .word 0
    j2_especie: .word 0

    escolha_j1: .word 0
    escolha_j2: .word 0

    num_pokemon: .word 5

    off_j1_x: .word 0
    off_j1_y: .word 0
    off_j2_x: .word 0
    off_j2_y: .word 0

    anim_hp2: .word 0
    anim_hp1: .word 0
    anim_atk: .word 0
    anim_ox:  .word 0
    anim_oy:  .word 0
    anim_tx:  .word 0
    anim_ty:  .word 0

    cor_atual: .word 0

    nome_pikachu:    .asciiz "PIKACHU"
    nome_eevee:      .asciiz "EEVEE"
    nome_charmander: .asciiz "CHARMANDER"
    nome_squirtle:   .asciiz "SQUIRTLE"
    nome_bulbasaur:  .asciiz "BULBASAUR"

