ac_raio:
    bgt $s1, $s3, ac_faiscas
    add $t0, $s1, $s0
    andi $t0, $t0, 1
    li $t1, -4
    beq $t0, 0, ac_zig_ok
    li $t1, 4
ac_zig_ok:
    add $a0, $s2, $t1
    move $a1, $s1
    li $a2, 4
    li $a3, 5
    jal desenha_retangulo
    addi $s1, $s1, 5
    j ac_raio

ac_faiscas:
    blt $s0, 2, ac_prox
    li $t0, 0x00FFEE00
    sw $t0, cor_atual
    lw $s4, anim_tx
    lw $s5, anim_ty
    addi $a0, $s4, -4
    addi $a1, $s5, 4
    li $a2, 4
    li $a3, 4
    jal desenha_retangulo
    addi $a0, $s4, 30
    addi $a1, $s5, 8
    li $a2, 4
    li $a3, 4
    jal desenha_retangulo
    addi $a0, $s4, 2
    addi $a1, $s5, 26
    li $a2, 4
    li $a3, 4
    jal desenha_retangulo
    addi $a0, $s4, 26
    addi $a1, $s5, 26
    li $a2, 4
    li $a3, 4
    jal desenha_retangulo
ac_prox:
    li $a0, 65
    jal espera
    addi $s0, $s0, 1
    j ac_frame

anim_cauda:
    li $s0, 0
acf_frame:
    beq $s0, 6, aa_fim
    jal zera_offsets
    bgt $s0, 3, acf_sem_off
    lw $t0, anim_atk
    beq $t0, 1, acf_off1
    li $t1, -10
    sw $t1, off_j2_x
    li $t1, 4
    sw $t1, off_j2_y
    j acf_sem_off
acf_off1:
    li $t1, 10
    sw $t1, off_j1_x
    li $t1, -4
    sw $t1, off_j1_y
acf_sem_off:
    lw $a0, anim_hp2
    lw $a1, anim_hp1
    jal desenha_arena

    andi $t0, $s0, 1
    li $t1, 0x00D0D8E0
    beq $t0, 0, acf_cor_ok
    li $t1, 0x00FFFFFF
acf_cor_ok:
    sw $t1, cor_atual

    lw $s2, anim_tx
    lw $s3, anim_ty
    li $t2, 3
    div $s0, $t2
    mfhi $t3
    beq $t3, 0, acf_horiz
    beq $t3, 1, acf_vert

    li $s1, 0
acf_diag:
    beq $s1, 7, acf_prox
    sll $t0, $s1, 2
    add $a0, $s2, $t0
    add $a1, $s3, $t0
    li $a2, 5
    li $a3, 5
    jal desenha_retangulo
    addi $s1, $s1, 1
    j acf_diag

acf_horiz:
    move $a0, $s2
    addi $a1, $s3, 13
    li $a2, 32
    li $a3, 5
    jal desenha_retangulo
    j acf_prox

acf_vert:
    addi $a0, $s2, 13
    move $a1, $s3
    li $a2, 5
    li $a3, 32
    jal desenha_retangulo

acf_prox:
    li $a0, 65
    jal espera
    addi $s0, $s0, 1
    j acf_frame

anim_investida:
    li $s0, 1
ain_ida:
    bgt $s0, 5, ain_impacto
    mul $t1, $s0, 10
    mul $t3, $s0, 4
    sub $t2, $zero, $t1
    sub $t4, $zero, $t3
    lw $t0, anim_atk
    beq $t0, 1, ain_ida1
    sw $t2, off_j2_x
    sw $t3, off_j2_y
    j ain_ida_draw
ain_ida1:
    sw $t1, off_j1_x
    sw $t4, off_j1_y
ain_ida_draw:
    lw $a0, anim_hp2
    lw $a1, anim_hp1
    jal desenha_arena
    li $a0, 40
    jal espera
    addi $s0, $s0, 1
    j ain_ida

ain_impacto:
    li $t0, 0x00FFFFFF
    sw $t0, cor_atual
    lw $a0, anim_tx
    addi $a0, $a0, 8
    lw $a1, anim_ty
    addi $a1, $a1, 8
    li $a2, 16
    li $a3, 16
    jal desenha_retangulo
    li $a0, 65
    jal espera

    li $s0, 4
ain_volta:
    bltz $s0, aa_fim
    mul $t1, $s0, 10
    mul $t3, $s0, 4
    sub $t2, $zero, $t1
    sub $t4, $zero, $t3
    lw $t0, anim_atk
    beq $t0, 1, ain_v1
    sw $t2, off_j2_x
    sw $t3, off_j2_y
    j ain_v_draw
ain_v1:
    sw $t1, off_j1_x
    sw $t4, off_j1_y
ain_v_draw:
    lw $a0, anim_hp2
    lw $a1, anim_hp1
    jal desenha_arena
    li $a0, 35
    jal espera
    subi $s0, $s0, 1
    j ain_volta

anim_mordida:
    li $s0, 0
am_frame:
    beq $s0, 6, aa_fim
    lw $a0, anim_hp2
    lw $a1, anim_hp1
    jal desenha_arena

    move $s1, $s0
    ble $s1, 3, am_clamp
    li $s1, 3
am_clamp:
    sll $s1, $s1, 2
    lw $s2, anim_tx
    lw $s3, anim_ty
    add $s4, $s3, $s1
    addi $s4, $s4, -2
    addi $s5, $s3, 28
    sub $s5, $s5, $s1

    li $t0, 0x00202020
    sw $t0, cor_atual
    addi $a0, $s2, 2
    addi $a1, $s4, -2
    li $a2, 28
    li $a3, 3
    jal desenha_retangulo
    addi $a0, $s2, 2
    addi $a1, $s5, 4
    li $a2, 28
    li $a3, 3
    jal desenha_retangulo

    li $t0, 0x00FFFFFF
    sw $t0, cor_atual
    li $s6, 4
am_dentes:
    bgt $s6, 22, am_flash
    add $a0, $s2, $s6
    move $a1, $s4
    li $a2, 5
    li $a3, 5
    jal desenha_retangulo
    add $a0, $s2, $s6
    move $a1, $s5
    li $a2, 5
    li $a3, 5
    jal desenha_retangulo
    addi $s6, $s6, 8
    j am_dentes

am_flash:
    blt $s0, 3, am_prox
    li $t0, 0x00E83A3A
    sw $t0, cor_atual
    addi $a0, $s2, 4
    addi $a1, $s3, 12
    li $a2, 24
    li $a3, 8
    jal desenha_retangulo
am_prox:
    li $a0, 70
    jal espera
    addi $s0, $s0, 1
    j am_frame

anim_arranhao:
    li $s0, 0
aar_frame:
    beq $s0, 6, aa_fim
    lw $a0, anim_hp2
    lw $a1, anim_hp1
    jal desenha_arena

    lw $s2, anim_tx
    lw $s3, anim_ty
    mul $s4, $s0, 4
    addi $s4, $s4, 6
    li $s1, 0
aar_passo:
    bgt $s1, $s4, aar_prox
    li $t0, 0x00FF3030
    sw $t0, cor_atual
    addi $a0, $s2, 26
    sub $a0, $a0, $s1
    addi $a1, $s3, 2
    add $a1, $a1, $s1
    li $a2, 3
    li $a3, 3
    jal desenha_retangulo

    li $t0, 0x00FFFFFF
    sw $t0, cor_atual
    addi $a0, $s2, 20
    sub $a0, $a0, $s1
    addi $a1, $s3, 2
    add $a1, $a1, $s1
    li $a2, 3
    li $a3, 3
    jal desenha_retangulo

    li $t0, 0x00FF3030
    sw $t0, cor_atual
    addi $a0, $s2, 29
    sub $a0, $a0, $s1
    addi $a1, $s3, 7
    add $a1, $a1, $s1
    li $a2, 3
    li $a3, 3
    jal desenha_retangulo

    addi $s1, $s1, 2
    j aar_passo
aar_prox:
    li $a0, 55
    jal espera
    addi $s0, $s0, 1
    j aar_frame

anim_brasas:
    li $s0, 0
ab_frame:
    beq $s0, 8, aa_fim
    lw $a0, anim_hp2
    lw $a1, anim_hp1
    jal desenha_arena

    bge $s0, 6, ab_explosao

    lw $t0, anim_ox
    lw $t1, anim_tx
    sub $t2, $t1, $t0
    mul $t2, $t2, $s0
    li $t3, 6
    div $t2, $t3
    mflo $t2
    add $s2, $t0, $t2
    addi $s2, $s2, 13

    lw $t0, anim_oy
    lw $t1, anim_ty
    sub $t2, $t1, $t0
    mul $t2, $t2, $s0
    li $t3, 6
    div $t2, $t3
    mflo $t2
    add $s3, $t0, $t2
    addi $s3, $s3, 13

    li $t0, 0x00FF4500
    sw $t0, cor_atual
    move $a0, $s2
    move $a1, $s3
    li $a2, 7
    li $a3, 7
    jal desenha_retangulo
    addi $a0, $s2, -7
    addi $a1, $s3, 5
    li $a2, 5
    li $a3, 5
    jal desenha_retangulo
    addi $a0, $s2, 7
    addi $a1, $s3, -5
    li $a2, 5
    li $a3, 5
    jal desenha_retangulo

    li $t0, 0x00FFEE00
    sw $t0, cor_atual
    addi $a0, $s2, 2
    addi $a1, $s3, 2
    li $a2, 3
    li $a3, 3
    jal desenha_retangulo
    addi $a0, $s2, -6
    addi $a1, $s3, 6
    li $a2, 3
    li $a3, 3
    jal desenha_retangulo
    addi $a0, $s2, 8
    addi $a1, $s3, -4
    li $a2, 3
    li $a3, 3
    jal desenha_retangulo
    j ab_prox

ab_explosao:
    lw $s2, anim_tx
    lw $s3, anim_ty
    li $t0, 0x00E02828
    sw $t0, cor_atual
    addi $a0, $s2, 4
    addi $a1, $s3, 4
    li $a2, 24
    li $a3, 24
    jal desenha_retangulo
    li $t0, 0x00FF8000
    sw $t0, cor_atual
    addi $a0, $s2, 8
    addi $a1, $s3, 8
    li $a2, 16
    li $a3, 16
    jal desenha_retangulo
    li $t0, 0x00FFEE00
    sw $t0, cor_atual
    addi $a0, $s2, 12
    addi $a1, $s3, 12
    li $a2, 8
    li $a3, 8
    jal desenha_retangulo

ab_prox:
    li $a0, 55
    jal espera
    addi $s0, $s0, 1
    j ab_frame

anim_jato:
    li $s0, 1
aj_frame:
    bgt $s0, 8, aa_fim
    lw $a0, anim_hp2
    lw $a1, anim_hp1
    jal desenha_arena

    move $s4, $s0
    ble $s4, 7, aj_lim
    li $s4, 7
aj_lim:
    li $s1, 0
aj_seg:
    bgt $s1, $s4, aj_splash
    lw $t0, anim_ox
    lw $t1, anim_tx
    sub $t2, $t1, $t0
    mul $t2, $t2, $s1
    li $t3, 7
    div $t2, $t3
    mflo $t2
    add $s2, $t0, $t2
    addi $s2, $s2, 12

    lw $t0, anim_oy
    lw $t1, anim_ty
    sub $t2, $t1, $t0
    mul $t2, $t2, $s1
    li $t3, 7
    div $t2, $t3
    mflo $t2
    add $s3, $t0, $t2
    addi $s3, $s3, 12

    li $t0, 0x002080FF
    sw $t0, cor_atual
    move $a0, $s2
    move $a1, $s3
    li $a2, 8
    li $a3, 8
    jal desenha_retangulo

    li $t0, 0x0090F0FF
    sw $t0, cor_atual
    addi $a0, $s2, 2
    addi $a1, $s3, 2
    li $a2, 4
    li $a3, 4
    jal desenha_retangulo

    addi $s1, $s1, 1
    j aj_seg

aj_splash:
    blt $s0, 7, aj_prox
    li $t0, 0x00FFFFFF
    sw $t0, cor_atual
    lw $s2, anim_tx
    lw $s3, anim_ty
    addi $a0, $s2, -2
    addi $a1, $s3, 4
    li $a2, 5
    li $a3, 4
    jal desenha_retangulo
    addi $a0, $s2, 29
    addi $a1, $s3, 8
    li $a2, 5
    li $a3, 4
    jal desenha_retangulo
    addi $a0, $s2, 6
    addi $a1, $s3, -2
    li $a2, 4
    li $a3, 5
    jal desenha_retangulo
    addi $a0, $s2, 22
    addi $a1, $s3, 28
    li $a2, 4
    li $a3, 5
    jal desenha_retangulo
aj_prox:
    li $a0, 55
    jal espera
    addi $s0, $s0, 1
    j aj_frame

anim_chicote:
    li $s0, 1
ach_frame:
    bgt $s0, 8, aa_fim
    lw $a0, anim_hp2
    lw $a1, anim_hp1
    jal desenha_arena

    move $s4, $s0
    ble $s4, 7, ach_lim
    li $s4, 7
ach_lim:
    li $s1, 0
ach_seg:
    bgt $s1, $s4, ach_golpe
    lw $t0, anim_ox
    lw $t1, anim_tx
    sub $t2, $t1, $t0
    mul $t2, $t2, $s1
    li $t3, 7
    div $t2, $t3
    mflo $t2
    add $s2, $t0, $t2
    addi $s2, $s2, 14

    lw $t0, anim_oy
    lw $t1, anim_ty
    sub $t2, $t1, $t0
    mul $t2, $t2, $s1
    li $t3, 7
    div $t2, $t3
    mflo $t2
    add $s3, $t0, $t2
    addi $s3, $s3, 14

    andi $t4, $s1, 1
    beq $t4, 0, ach_onda
    addi $s3, $s3, 4
ach_onda:
    li $t0, 0x00208830
    sw $t0, cor_atual
    move $a0, $s2
    move $a1, $s3
    li $a2, 6
    li $a3, 6
    jal desenha_retangulo

    li $t0, 0x0070E850
    sw $t0, cor_atual
    addi $a0, $s2, 2
    addi $a1, $s3, 2
    li $a2, 2
    li $a3, 2
    jal desenha_retangulo

    addi $s1, $s1, 1
    j ach_seg

ach_golpe:
    blt $s0, 7, ach_prox
    li $t0, 0x0070E850
    sw $t0, cor_atual
    lw $a0, anim_tx
    lw $a1, anim_ty
    addi $a1, $a1, 14
    li $a2, 32
    li $a3, 4
    jal desenha_retangulo
ach_prox:
    li $a0, 55
    jal espera
    addi $s0, $s0, 1
    j ach_frame

anim_defesa:
    li $s0, 0
adf_frame:
    beq $s0, 5, aa_fim
    lw $a0, anim_hp2
    lw $a1, anim_hp1
    jal desenha_arena

    andi $t0, $s0, 1
    li $t1, 0x0050D8FF
    beq $t0, 0, adf_cor_ok
    li $t1, 0x00FFFFFF
adf_cor_ok:
    sw $t1, cor_atual

    lw $s2, anim_ox
    lw $s3, anim_oy
    addi $a0, $s2, -3
    addi $a1, $s3, -3
    li $a2, 38
    li $a3, 3
    jal desenha_retangulo
    addi $a0, $s2, -3
    addi $a1, $s3, 32
    li $a2, 38
    li $a3, 3
    jal desenha_retangulo
    addi $a0, $s2, -3
    addi $a1, $s3, -3
    li $a2, 3
    li $a3, 38
    jal desenha_retangulo
    addi $a0, $s2, 32
    addi $a1, $s3, -3
    li $a2, 3
    li $a3, 38
    jal desenha_retangulo

    li $a0, 70
    jal espera
    addi $s0, $s0, 1
    j adf_frame

anim_cura:
    li $s0, 0
acu_frame:
    beq $s0, 6, aa_fim
    lw $a0, anim_hp2
    lw $a1, anim_hp1
    jal desenha_arena

    li $t0, 0x0040E050
    sw $t0, cor_atual

    lw $s2, anim_ox
    lw $s3, anim_oy
    sll $t1, $s0, 2
    addi $s4, $s3, 24
    sub $s4, $s4, $t1

    addi $a0, $s2, 2
    addi $a1, $s4, 2
    li $a2, 6
    li $a3, 2
    jal desenha_retangulo
    addi $a0, $s2, 4
    move $a1, $s4
    li $a2, 2
    li $a3, 6
    jal desenha_retangulo

    addi $a0, $s2, 13
    addi $a1, $s4, -4
    li $a2, 6
    li $a3, 2
    jal desenha_retangulo
    addi $a0, $s2, 15
    addi $a1, $s4, -6
    li $a2, 2
    li $a3, 6
    jal desenha_retangulo

    addi $a0, $s2, 24
    addi $a1, $s4, 4
    li $a2, 6
    li $a3, 2
    jal desenha_retangulo
    addi $a0, $s2, 26
    addi $a1, $s4, 2
    li $a2, 2
    li $a3, 6
    jal desenha_retangulo

    li $a0, 70
    jal espera
    addi $s0, $s0, 1
    j acu_frame

aa_fim:
    jal zera_offsets
    lw $a0, anim_hp2
    lw $a1, anim_hp1
    jal desenha_arena

    lw $s7, 0($sp)
    lw $s6, 4($sp)
    lw $s5, 8($sp)
    lw $s4, 12($sp)
    lw $s3, 16($sp)
    lw $s2, 20($sp)
    lw $s1, 24($sp)
    lw $s0, 28($sp)
    lw $ra, 32($sp)
    addi $sp, $sp, 36
    jr $ra