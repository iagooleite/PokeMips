    i_pocao:     .asciiz "POCAO"

    txt_titulo:     .asciiz "POKEMIPS"
    txt_modo:       .asciiz "MODO DE JOGO:"
    txt_modo1:      .asciiz "1 - JOGADOR VS JOGADOR"
    txt_modo2:      .asciiz "2 - JOGADOR VS IA"
    txt_dig_12:     .asciiz "> DIGITE 1 OU 2"
    txt_esc_j1:     .asciiz "JOGADOR 1 ESCOLHA:"
    txt_esc_j2:     .asciiz "JOGADOR 2 ESCOLHA:"
